{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vlist-cloudflare-backend",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIST_DOCUMENT",
        "class_name": "ListDocumentDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ListDocumentDO"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "vlist-cloudflare-backend.smileme.ai",
      "zone_name": "smileme.ai"
    },
    {
      "pattern": "vlist-cloudflare-backend.smileme.ai/*",
      "zone_name": "smileme.ai"
    }
  ],
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-4.1-mini"
  }
}
