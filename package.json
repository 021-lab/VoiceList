    "serve:test": "node scripts/static-server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
